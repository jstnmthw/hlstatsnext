# Environment variables for the web app
# Copy this file to .env and update values for your environment.
NODE_ENV=development

# Application name
NEXT_PUBLIC_APP_NAME="HLStatsNext"

# GraphQL URL
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Database (required for the Better Auth Prisma adapter)
DATABASE_URL="mysql://hlstatsnext:CHANGE_ME@localhost:3306/hlstatsnext"

# Better Auth — validated at startup by @repo/auth; must match apps/api.
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_BASE64_32_BYTES"
BETTER_AUTH_URL=http://localhost:3000

# Admin bootstrap (optional). A sign-up with one of these addresses becomes an
# admin; further admins are promoted from the users page.
ADMIN_EMAILS=

# Google OAuth (optional). Set both or neither; blank values count as unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail provider: "console" (logs OTP to stdout) or "resend" (sends via Resend API).
# RESEND_API_KEY is required when MAIL_PROVIDER=resend.
MAIL_PROVIDER=console
MAIL_FROM=noreply@hlstatsnext.com
RESEND_API_KEY=
